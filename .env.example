# Copy to .env and fill in. Never commit .env.
# Format: KEY=value (no spaces around "=", no quotes needed).

# --- LLM gateway (AvalAI, OpenAI-compatible) ---
AVALAI_API_KEY=
# Default public endpoint; internal mirror: https://api.avalapis.ir/v1
AVALAI_BASE_URL=https://api.avalai.ir/v1

# Provider adapter selected by the composition root: avalai | fake
LLM__PROVIDER=avalai
# Hard project-wide spend cap in USD (ledger-enforced); per-job caps live in config/llm.toml
LLM__BUDGET__PROJECT_USD=30

# --- Crawling ---
# Contact shown in the crawler User-Agent (URL or email you are comfortable publishing)
CRAWL__CONTACT=
# offline = snapshots only (default for development); live = network fetches allowed
CRAWL__MODE=offline
