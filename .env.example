# Copy to .env and fill in. Never commit .env.
# Format: KEY=value (no spaces around "=", no quotes needed). Every key is listed without a value;
# the comment above each one says what it means and what the code uses when it is left out.

# --- LLM gateway (AvalAI, OpenAI-compatible) ---
# Your own key. Without it the stack runs with LLM__PROVIDER=fake (tests) or offline (cached answers).
AVALAI_API_KEY=
# Left out: the public endpoint https://api.avalai.ir/v1
AVALAI_BASE_URL=
# avalai | fake | offline. Left out: fake. Set avalai to call the real models.
LLM__PROVIDER=
# Hard project-wide spend cap in USD (ledger-enforced). Left out: 30. Per-job caps: config/llm.toml
LLM__BUDGET__PROJECT_USD=

# --- Crawling ---
# Contact shown in the crawler User-Agent (a URL or e-mail you are comfortable publishing)
CRAWL__CONTACT=
# offline = snapshots only; live = network fetches allowed. Left out: offline.
CRAWL__MODE=

# --- Local stack ---
# Address the web app (port 3300) listens on. Left out: 127.0.0.1 (this machine only);
# 0.0.0.0 opens it to devices on your network.
VILLASANJ_WEB_BIND=
