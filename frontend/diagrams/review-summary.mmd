flowchart TB
  accTitle: خلاصه‌ی نظرها با ارجاع
  accDescr: جدیدترین نظرهای متنی همه‌ی پلتفرم‌ها با شناسه‌ی کوتاه به مدل داده می‌شوند؛ هر نکته باید به نظرهای موجود ارجاع دهد و عدد یا مقایسه‌ی سنجیدنی نداشته باشد؛ «نظر یک مهمان» را کد تعیین می‌کند.
  reviews[("نظرهای همه‌ی پلتفرم‌ها")]:::store --> choose["جدیدترین نظرهای متنی<br/>با شناسه‌ی R1...Rn"]
  choose --> llm["مدل زبانی<br/>خوب‌ها و ایرادها"]:::llm
  llm --> verify{"ارجاع موجود؟ بدون عدد و پول؟"}:::decision
  verify -- "نه" --> retry["یک تلاش با فهرست خطاها"]
  retry --> verify2{"باز هم خطا؟"}:::decision
  verify2 -- "بله" --> dropp["حذف آن نکته"]:::warn
  verify -- "بله" --> map["نگاشت شناسه به نظر<br/>platform:review_id"]
  verify2 -- "نه" --> map
  map --> single["تک‌نظر یا چندنظر<br/>با کد، نه با مدل"]
  single --> ui["کارت خلاصه با پیوند<br/>به هر نظر"]:::good
