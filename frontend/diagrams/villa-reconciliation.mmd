flowchart TB
  accTitle: ادغام، تقسیم و پایداری شناسه‌ی ویلاها
  accDescr: هر شناسه‌ی قدیمی به خوشه‌ی جدیدی می‌رسد که بیشترین هم‌پوشانی را دارد؛ خوشه‌ی بی‌وارث شناسه‌ی تازه‌ای می‌گیرد که هرگز با شناسه‌ای دیگر یکی نیست، و هر تغییر در تاریخچه ثبت می‌شود.
  prev[("ویلاهای قبلی<br/>id → اعضا")]:::store --> overlap["هم‌پوشانی هر شناسه‌ی قدیمی<br/>با هر خوشه‌ی جدید"]
  next["خوشه‌های جدید"] --> overlap
  overlap --> assign["هر شناسه به خوشه‌ی<br/>بیشترین هم‌پوشانی"]
  assign --> fresh{"خوشه وارث دارد؟"}:::decision
  fresh -- "بله" --> keep["همان شناسه"]:::good
  fresh -- "نه" --> salt["شناسه از هش اعضا<br/>با نمک تا تکراری نشود"]
  keep --> events["رویدادها<br/>created · merged · split · retired"]
  salt --> events
  events --> store[("er.villa_event")]:::store
