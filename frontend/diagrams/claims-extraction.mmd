flowchart TB
  accTitle: استخراج ادعاهای امکانات
  accDescr: قواعد اول اجرا می‌شوند؛ مدل فقط امکاناتی را می‌خواند که قواعد چیزی درباره‌شان نیافته‌اند، و هر نقل‌قول باید عیناً در متن باشد.
  text["متن توضیحات"] --> rules["قواعد قطعی<br/>واژه، نفی، مشاع"]
  rules --> found["ادعاهای قواعد"]:::good
  rules --> residue["امکاناتی که قواعد<br/>چیزی نیافتند"]
  residue --> llm["مدل زبانی<br/>claim_extraction"]:::llm
  llm --> quote{"نقل‌قول عیناً در متن؟"}:::decision
  quote -- "نه، یک بار دیگر" --> llm
  quote -- "باز نه" --> dropq["حذف"]:::warn
  quote -- "بله" --> read["ادعای خوانده‌شده<br/>llm_extracted"]
  found --> merged["ادغام زیر قواعد<br/>قاعده همیشه برنده"]
  read --> merged
  merged --> use["حقیقت‌سنجی و جستجو"]
