flowchart TB
  accTitle: خط لوله‌ی راستی‌آزمایی
  accDescr: ادعای فاصله به بازه تبدیل و با بهترین حالت نقشه سنجیده می‌شود؛ ادعای امکانات با فهرست امکانات و عکس‌ها؛ و در ویلاهای دوپلتفرمی گفته‌های دو آگهی کنار هم.
  subgraph dist ["ادعای فاصله"]
    claim["«زیر ۵ دقیقه تا دریا»"] --> readings["خوانش‌ها<br/>پیاده و سواره، با گرد کردن"]
    readings --> range["بازه‌ی فاصله‌ی ادعا"]
    map["بازه‌ی اندازه‌گیری‌شده<br/>دایره‌ی محو تا ساحل یا POI"]:::store --> assess
    range --> assess{"حتی بهترین حالت می‌رسد؟"}:::decision
    assess -- "همه‌جا می‌رسد" --> sup["تأیید شد"]:::good
    assess -- "هیچ‌جا نمی‌رسد" --> con["با نقشه نمی‌خواند"]:::warn
    assess -- "بستگی دارد" --> nc["تأیید نشد"]
  end
  subgraph feat ["ادعای امکانات"]
    text["توضیحات"] --> rules["قواعد<br/>نفی، مشاع"]
    rules --> residue["باقی‌مانده<br/>LLM با نقل‌قول عینی"]:::llm
    residue --> amen{"فهرست امکانات همان آگهی"}:::decision
    photos["برچسب عکس<br/>فقط تأیید می‌کند"] --> amen
  end
  subgraph cross ["بین پلتفرم‌ها"]
    a["گفته‌ی آگهی جاباما"] --> cmp{"بدون ابهام متضادند؟"}:::decision
    b["گفته‌ی آگهی شب"] --> cmp
    cmp -- "بله" --> inc["یکسان نمی‌گویند"]
  end
