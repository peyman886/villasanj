flowchart TB
  accTitle: معماری کل سامانه‌ی ویلاسنج
  accDescr: مرورگر به وب Next.js وصل است که از API و گزارش‌ها می‌خواند؛ API و کارهای دسته‌ای از Postgres، ذخیره‌ساز فایل، دروازه‌ی مدل زبانی و OSRM استفاده می‌کنند.
  user(["کاربر و بازبین<br/>Browser"]):::human
  subgraph web ["وب · Next.js (SSR، RTL)"]
    pages["صفحه‌های محصول<br/>/ /search /villas /listings"]
    docs["پورتال مستندات<br/>/docs /en/docs"]
    tiles["نقشه‌ی آفلاین<br/>/basemap (PMTiles)"]
  end
  subgraph api ["API · FastAPI"]
    routes["مسیرها<br/>listings, villas, search, metrics"]
    root["ریشه‌ی ترکیب<br/>container.py"]
  end
  subgraph batch ["کارهای دسته‌ای · CLI"]
