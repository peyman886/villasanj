flowchart TB
  accTitle: از پرسش تا توضیح
  accDescr: مدل فقط پرسش را به ساختار تبدیل می‌کند؛ هر عدد را محافظ‌ها با متن پرسش می‌سنجند، و رتبه و توضیح را کد می‌سازد.
  q["پرسش فارسی"] --> und["فهم پرسش<br/>LLM → SearchIntent"]:::llm
  und --> guard{"هر عدد در متن پرسش هست؟<br/>مبنای بودجه گفته شده؟"}:::decision
  guard -- "نه" --> drop["عدد حذف یا نامعلوم"]:::warn
  guard -- "بله" --> intent["شرط‌ها و خواسته‌های نسنجیدنی"]
  drop --> intent
  intent --> dates["تاریخ‌ها با کد<br/>تقویم جلالی و تعطیلات"]
  dates --> filters["فیلترها با دلیل<br/>فقط واقعیت‌های گفته‌شده"]
  filters --> rank["رتبه‌ی شفاف<br/>تأییدشده‌ها اول، بعد امتیاز"]
  rank --> group["یک نتیجه برای هر ویلا<br/>پیشنهاد پلتفرم دیگر کنارش"]
  group --> explain["توضیح<br/>اسلات‌ها با کد، متن با مدل"]:::llm
  explain --> verify{"بررسی‌گر<br/>عدد، مقایسه، وضعیت"}:::decision
  verify -- "رد شد دو بار یا مدل نیست" --> template["الگوی ثابت"]
  verify -- "قبول" --> shown["متن مدل"]:::good
