  "paths": {
    "/er/labels": {
      "post": {
        "operationId": "record_label_er_labels_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabelOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record Label",
        "tags": [
          "entity-resolution"
        ]
      }
    },
    "/er/queues/{queue}/task": {
      "get": {
        "description": "The pair at ``position``, or the next unlabelled one (204 when the queue is done).",
        "operationId": "task_er_queues__queue__task_get",
        "parameters": [
          {
            "in": "path",
            "name": "queue",
            "required": true,
            "schema": {
              "title": "Queue",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "labeler",
            "required": false,
            "schema": {
              "default": "owner",
              "title": "Labeler",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "position",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Position"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Task",
        "tags": [
          "entity-resolution"
        ]
      }
    },
